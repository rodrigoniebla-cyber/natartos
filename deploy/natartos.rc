# natartos.rc — OPT-IN boot start for natartos.
#
# Installed to /vendor/etc/init/natartos.rc (NEVER /system). Android init
# imports every /vendor/etc/init/*.rc at boot. This adds one oneshot service
# that runs boot.sh after the system reports boot-complete.
#
# This file running does NOT by itself start mods: boot.sh is a no-op unless
# the user created /data/.natartos_boot_enabled. Delete this .rc (or run
# `toolya natartos uninstall`) to remove boot start entirely.
#
# NOTE (device-specific): the seclabel below is the piece most likely to need
# adjusting per firmware build. If init refuses the service, nothing starts and
# the goggles come up STOCK — a non-event, not a brick. Verify in
# /data/local/tmp/natartos_boot.log and dmesg before trusting it.

service natartos_boot /system/bin/sh /vendor/natartos/boot.sh
    class late_start
    user root
    group root system
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start natartos_boot
