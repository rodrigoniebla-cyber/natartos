# natartos.rc — OPT-IN boot start (installed to /vendor/etc/init, never /system).
#
# Runs boot.sh at power-on as the vendor_init domain. That domain is made
# permissive by the natartos SELinux patch (precompiled_sepolicy on /vendor);
# boot.sh then sets global permissive via devmem and launches the menu.
#
# Trigger: dji.glasses_service=1 — the property DJI's init sets to start the
# display (sys.boot_completed is never set on this firmware).

service natartos_boot /system/bin/sh /vendor/natartos/boot.sh
    class late_start
    user root
    group root system
    seclabel u:r:vendor_init:s0
    oneshot
    disabled

on property:dji.glasses_service=1
    start natartos_boot
